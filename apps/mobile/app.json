{
  "expo": {
    "name": "Stackkeel",
    "slug": "stackkeel",
    "scheme": "stackkeel",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.example.stackkeel.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.stackkeel.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
