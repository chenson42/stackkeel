# apps/portal — environment variables (port 3000).
#
# The root .env.example is the canonical inventory with full commentary for
# everything shared across apps (DATABASE_URL, AUTH_SECRET,
# AUTH_TOTP_ENCRYPTION_KEY and its cannot-rotate warning, Google/OIDC
# credentials, Resend, Upstash, Turnstile, CRON_SECRET, INITIAL_ADMIN_EMAILS).
# Set the shared values once and mirror them here; this file documents only
# what is portal-specific or app-scoped.

# ── Identity ────────────────────────────────────────────────────────────────
# This app's own public origin. Used for email links and OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Where the app switcher and cross-app links send admins.
# kit-module:admin-begin
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# kit-module:admin-end

# ── Shared session (cross-app SSO) ──────────────────────────────────────────
# Leave unset in local dev (host-only cookies work across localhost ports).
# On deployed environments set the PARENT domain with a leading dot on BOTH
# apps identically, e.g. `.example.com`, so portal and admin share the
# session cookie.
# AUTH_COOKIE_DOMAIN=.example.com

# JWT session lifetime. Unset = 86400 (24h).
# SESSION_MAX_AGE_SECONDS=86400

# ── Shared (see root .env.example for commentary) ───────────────────────────
DATABASE_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_TOTP_ENCRYPTION_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
INITIAL_ADMIN_EMAILS=
RESEND_API_KEY=
RESEND_FROM_EMAIL="App <noreply@example.com>"
# RESEND_WEBHOOK_SECRET=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# CRON_SECRET=

# kit-module:device-auth-begin
# ── Mobile (module `mobile`) ────────────────────────────────────────────────
# Deep-link scheme the shell/Expo app register; personalize rewrites it with
# the app identity. Public.
# NEXT_PUBLIC_APP_SCHEME=stackkeel
# Update-CTA links shown by the version gate (TestFlight / Play Store or a
# direct APK URL). Public.
# NEXT_PUBLIC_IOS_APP_URL=
# NEXT_PUBLIC_ANDROID_APP_URL=
# iOS Universal Links (/.well-known/apple-app-site-association). Both are
# PUBLIC Apple identifiers (also used for APNs later); unset = links disabled.
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.example.stackkeel
# Android App Links (/.well-known/assetlinks.json). The cert fingerprint is
# the app-signing SHA-256 (public); unset = links disabled.
# ANDROID_PACKAGE_NAME=com.example.stackkeel
# ANDROID_CERT_SHA256=
# kit-module:device-auth-end

# ── Dev conveniences ────────────────────────────────────────────────────────
# Redirect all outbound email to one inbox in dev instead of real recipients.
# EMAIL_DEV_INTERCEPT=true
# EMAIL_DEV_REDIRECT_TO=you@example.com
# Disable rate limiting locally when iterating on auth flows.
# RATE_LIMIT_DISABLED=true

# ── E2E seed accounts (only read by the e2e seed script) ────────────────────
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_MEMBER_EMAIL=member@example.com
# SEED_MEMBER_PASSWORD=
# SEED_MFA_ADMIN_EMAIL=mfa-admin@example.com
# SEED_MFA_ADMIN_PASSWORD=
# SEED_MFA_VERIFIED_EMAIL=mfa-member@example.com
# SEED_MFA_VERIFIED_PASSWORD=
