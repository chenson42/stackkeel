# apps/admin — environment variables (port 3001).
#
# The root .env.example is the canonical inventory with full commentary for
# everything shared across apps. Set the shared values once and mirror them
# here; this file documents only what is admin-specific or app-scoped.
#
# Shared-meaning rule: DATABASE_URL, AUTH_SECRET, AUTH_COOKIE_DOMAIN and
# AUTH_TOTP_ENCRYPTION_KEY must be IDENTICAL across portal and admin — one
# identity schema, one shared session, one TOTP key. Google OAuth may use a
# separate OAuth client per app (each app has its own callback URL).

# ── Identity ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
AUTH_URL=http://localhost:3001

# Where the app switcher sends people back to the portal.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000/home

# ── Shared session (cross-app SSO) ──────────────────────────────────────────
# Must match apps/portal exactly. See that file and the root inventory.
# AUTH_COOKIE_DOMAIN=.example.com
# SESSION_MAX_AGE_SECONDS=86400

# ── Shared (see root .env.example for commentary) ───────────────────────────
DATABASE_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_TOTP_ENCRYPTION_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
INITIAL_ADMIN_EMAILS=
RESEND_API_KEY=
RESEND_FROM_EMAIL="App Admin <noreply@example.com>"
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Dev conveniences ────────────────────────────────────────────────────────
# EMAIL_DEV_INTERCEPT=true
# EMAIL_DEV_REDIRECT_TO=you@example.com
# RATE_LIMIT_DISABLED=true
