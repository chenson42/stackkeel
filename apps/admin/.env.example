# Kindway Admin (apps/admin) — environment variables. Mirrors apps/portal's
# .env.example conventions; this app is standalone (not part of the shared
# SSO cookie domain yet — umbrella Ruling 1/5), so no AUTH_COOKIE_DOMAIN is
# set here by default.

# Same shared Neon Postgres project as npvitals/Portal — see
# apps/admin/drizzle.config.ts's own bookkeeping-schema note.
DATABASE_URL=

# NextAuth v5 uses AUTH_URL (not the v4 NEXTAUTH_URL).
AUTH_URL=http://localhost:3002
AUTH_SECRET=

# Separate Google Cloud OAuth client from npvitals'/Portal's own — same env
# var NAMES, different values, per DECISION-047/048's established pattern.
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# TOTP secret encryption (AES-256-GCM). Shared meaning with npvitals/Portal
# but each app may use its own value — rotating it invalidates every
# enrolled TOTP secret in THIS app's own userTotp rows.
AUTH_TOTP_ENCRYPTION_KEY=

# Used to build the /set-password invite link in outbound email.
NEXT_PUBLIC_APP_URL=http://localhost:3002

# --- Cross-app switcher sibling URLs (2026-09-04-cross-app-switcher) -------
# Static, per-environment base URLs for the OTHER two apps' own top-level
# landing pages, read by apps/admin/src/lib/app-switcher.ts to build the
# switcher's tile hrefs. Unset locally = the confirmed local dev defaults
# below (npvitals 3000, Portal 3001). Must always be a literal,
# server-configured value — never derived from a query string or client
# state (DECISION-059 ruling 4, binding invariant).
NEXT_PUBLIC_NPVITALS_URL=http://localhost:3000/dashboard
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001/home

# --- Email ------------------------------------------------------------------
# NOT NEEDED as of 2026-09-05. This app no longer sends mail itself: it writes
# to the shared email_queue (public schema) and the cron worker delivers it,
# so RESEND_API_KEY belongs to whichever deployment runs that worker, not
# here. Kept commented as a breadcrumb — setting it here does nothing.
#   RESEND_API_KEY=
#   RESEND_FROM_EMAIL="Kindway Admin <noreply@kindway.org>"

# Never set in production — bypasses src/lib/rate-limit.ts for local/e2e runs.
# RATE_LIMIT_DISABLED=true
