{
  "name": "stackkeel",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-AI monorepo starter kit: portal + admin + native shell + native app, with built-in maintenance, helpdesk, theming, and a personalization/sync loop.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chenson42/stackkeel"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo dev",
    "predev": "node scripts/kit/kit-check.mjs --banner",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "node scripts/run-tripwires.mjs",
    "kit:check": "node scripts/kit/kit-check.mjs",
    "kit:status": "node scripts/kit/kit-status.mjs",
    "kit:verify": "node scripts/kit/kit-verify.mjs",
    "kit:strip": "node scripts/kit/strip-module.mjs",
    "brand:generate": "pnpm --filter @repo/brand run generate",
    "stats:escape": "node scripts/stats-escape.mjs",
    "prepare": "bash scripts/install-hooks.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "~19.2.18"
    }
  }
}
