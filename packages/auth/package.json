{
  "name": "@repo/auth",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./two-factor": {
      "types": "./src/two-factor.ts",
      "default": "./src/two-factor.ts"
    },
    "./totp-pending": {
      "types": "./src/totp-pending.ts",
      "default": "./src/totp-pending.ts"
    },
    "./lockout": {
      "types": "./src/lockout.ts",
      "default": "./src/lockout.ts"
    },
    "./safe-callback": {
      "types": "./src/safe-callback.ts",
      "default": "./src/safe-callback.ts"
    },
    "./post-signin": {
      "types": "./src/post-signin.ts",
      "default": "./src/post-signin.ts"
    },
    "./sign-in-gate": {
      "types": "./src/sign-in-gate.ts",
      "default": "./src/sign-in-gate.ts"
    },
    "./google-native-authorize": {
      "types": "./src/google-native-authorize.ts",
      "default": "./src/google-native-authorize.ts"
    },
    "./audit": {
      "types": "./src/audit.ts",
      "default": "./src/audit.ts"
    },
    "./jwt": {
      "types": "./src/jwt.ts",
      "default": "./src/jwt.ts"
    },
    "./verify-recovery-code": {
      "types": "./src/verify-recovery-code.ts",
      "default": "./src/verify-recovery-code.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    }
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@repo/db": "workspace:*",
    "@repo/permissions": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "next-auth": "5.0.0-beta.32",
    "otplib": "^13.4.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6"
  }
}
