# ===========================================================================
# Canonical environment inventory. Copy to .env.local per app and fill in.
# Every variable notes which module needs it; strip entries for modules you
# deselect at personalization.
# ===========================================================================

# --- Database (core) -------------------------------------------------------
# Postgres connection string. Local dev: docker Postgres or a Neon branch.
# localhost URLs select the node-postgres driver automatically.
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/app"
# Unpooled/direct connection for migrations (DDL through a pooler can
# deadlock). Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=""

# --- Auth core (core) ------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app for OAuth callbacks, e.g. https://app.example.com
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Comma-separated emails granted the admin role by db:seed.
INITIAL_ADMIN_EMAILS=""
# Shared cookie domain for cross-app SSO (portal + admin on subdomains of
# one apex), e.g. ".example.com". PRODUCTION ONLY — never set in local dev.
AUTH_COOKIE_DOMAIN=""
# Session lifetime in seconds. Default 86400 (24h).
SESSION_MAX_AGE_SECONDS=""

# --- Google OAuth (core; optional provider) --------------------------------
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Native shell's Google Sign-In: the iOS/Android client id accepted as a
# second audience by the google-native provider (shell module).
AUTH_GOOGLE_IOS_ID=""

# --- Generic OIDC SSO slot (oidc module) -----------------------------------
# Set all three to enable an enterprise IdP (Okta/Entra/Auth0/Keycloak).
# Discovery runs against {issuer}/.well-known/openid-configuration.
AUTH_OIDC_ISSUER=""
AUTH_OIDC_ID=""
AUTH_OIDC_SECRET=""
# Sign-in button label. Defaults to "SSO".
AUTH_OIDC_NAME=""

# --- Two-factor auth (twoFactor module) ------------------------------------
# openssl rand -base64 32 — MUST decode to exactly 32 bytes.
# WARNING: rotating this key invalidates EVERY enrolled TOTP secret; every
# enrolled user must re-enroll. Treat it like a root credential.
AUTH_TOTP_ENCRYPTION_KEY=""

# --- Email (emailQueue module) ---------------------------------------------
RESEND_API_KEY=""
# Verified sender, e.g. "App <no-reply@example.com>"
RESEND_FROM_EMAIL=""
# Dev safety: when set, every queued email is redirected to this address.
EMAIL_DEV_REDIRECT_TO=""

# --- Rate limiting (core; optional) ----------------------------------------
# When unset, an in-memory limiter is used (fine for single-instance dev).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- CAPTCHA (core; optional — no-op until keyed) --------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Crons (core) -----------------------------------------------------------
# Bearer token protecting /api/cron/* routes. openssl rand -base64 32
CRON_SECRET=""

# --- App identity ----------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
